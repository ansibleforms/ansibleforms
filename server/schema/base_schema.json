{
  "type": "object",
  "required": [
    "categories",
    "roles"
  ],
  "properties": {
    "categories": {
      "type": "array",
      "contains": {
        "const": {
          "name": "Default",
          "icon": "bars"
        }
      },
      "items": {
        "$id": "/category",
        "type": "object",
        "required": [
          "name",
          "icon"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[^/]{2,50}$"
          },
          "icon": {
            "$id": "/icon",
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "/category"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "roles": {
      "type": "array",
      "contains": {
        "type": "object",
        "properties": {
          "name": { "enum": ["default", "public"]},
          "description": { "type": "string" },
          "groups": { "const": []},
          "options": {
            "type": "object",
            "properties": {
              "showDesigner": { "type": "boolean"},
              "allowFormDesign": { "type": "boolean" },
              "designAllForms": { "type": "boolean" },
              "allowPlaybookDesign": { "type": "boolean" },
              "designAllPlaybooks": { "type": "boolean" },
              "allowWorkflowDesign": { "type": "boolean" },
              "designAllWorkflows": { "type": "boolean" },
              "allowInventoryDesign": { "type": "boolean" },
              "allowVarsFileDesign": { "type": "boolean" },
              "showLogs": { "type": "boolean" },
              "showAuditLog": { "type": "boolean" },
              "showAppearanceSettings": { "type": "boolean" },
              "showConnectionsSettings": { "type": "boolean" },
              "showDebugButtons": { "type": "boolean" },
              "showSettings": { "type": "boolean" },
              "showExtravars": { "type": "boolean" },
              "allowApiTokens": { "type": "boolean" },
              "extendedTokenExpiration": { "type": "boolean" },
              "showAllJobLogs": { "type": "boolean" },
              "allowBackupOps": { "type": "boolean" },
              "allowVerboseMode": { "type": "boolean" },
              "allowScheduledJobs": { "type": "boolean" },
              "allowStoredJobs": { "type": "boolean" },
              "allowStoredJobsShare": { "type": "boolean" },
              "allowStoredJobsViewAll": { "type": "boolean" },
              "allowJobDeletion": { "type": "boolean" },
              "manageAllJobs": { "type": "boolean" },
              "allowPlannedJobs": { "type": "boolean" },
              "allowChat": { "type": "boolean" },
              "allowMcp": { "type": "boolean" },
              "allowFileUploads": { "type": "boolean" },
              "allowLogin": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": false
      },
      "items": {
        "type": "object",
        "required": [
          "name"
        ],
        "if": { "properties": { "name": { "enum": ["default", "public"] } }, "required": ["name"] },
        "then": { "properties": { "groups": { "const": [] }, "users": { "not": {} }, "credentials": { "not": {} }, "secretStores": { "not": {} }, "runners": { "not": {} } } },
        "anyOf": [
          {
            "required": [
              "groups"
            ]
          },{
            "required": [
              "users"
            ]
          }
        ],        
        "properties": {
          "name": {
            "$id": "/role",
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "options": {
            "type": "object",
            "properties": {
              "showDesigner": { "type": "boolean"},
              "allowFormDesign": { "type": "boolean" },
              "designAllForms": { "type": "boolean" },
              "allowPlaybookDesign": { "type": "boolean" },
              "designAllPlaybooks": { "type": "boolean" },
              "allowWorkflowDesign": { "type": "boolean" },
              "designAllWorkflows": { "type": "boolean" },
              "allowInventoryDesign": { "type": "boolean" },
              "allowVarsFileDesign": { "type": "boolean" },
              "showLogs": { "type": "boolean" },
              "showAuditLog": { "type": "boolean" },
              "showAppearanceSettings": { "type": "boolean" },
              "showConnectionsSettings": { "type": "boolean" },
              "showDebugButtons": { "type": "boolean" },
              "showSettings": { "type": "boolean" },
              "showExtravars": { "type": "boolean" },
              "allowApiTokens": { "type": "boolean" },
              "extendedTokenExpiration": { "type": "boolean" },
              "showAllJobLogs": { "type": "boolean" },
              "allowBackupOps": { "type": "boolean" },
              "allowVerboseMode": { "type": "boolean" },
              "allowScheduledJobs": { "type": "boolean" },
              "allowStoredJobs": { "type": "boolean" },
              "allowStoredJobsShare": { "type": "boolean" },
              "allowStoredJobsViewAll": { "type": "boolean" },
              "allowJobDeletion": { "type": "boolean" },
              "manageAllJobs": { "type": "boolean" },
              "allowPlannedJobs": { "type": "boolean" },
              "allowChat": { "type": "boolean" },
              "allowMcp": { "type": "boolean" },
              "allowFileUploads": { "type": "boolean" },
              "allowLogin": { "type": "boolean" }
            },
            "additionalProperties": true
          },
          "groups": {
            "type": "array",
            "items": {
              "type": "string",
              "default": "",
              "pattern": "(\\blocal\\b|\\bldap\\b|\\bentraid\\b|\\bazuread\\b|\\boidc\\b)\\/.+"
            }
          },
          "users": {
            "type": "array",
            "items": {
              "type": "string",
              "default": "",
              "pattern": "(\\blocal\\b|\\bldap\\b|\\bentraid\\b|\\bazuread\\b|\\boidc\\b)\\/.+"
            }            
          },
          "credentials": {
            "type": "array",
            "description": "The credentials this role may use, as regexes matching the whole name (__self__ is the app's own database). A user is limited once one of their roles lists them, and may use what any of those roles allows.",
            "items": { "type": "string", "minLength": 1 }
          },
          "secretStores": {
            "type": "array",
            "description": "The secret stores this role may read inline (vault:<path>, secret:<store>:<ref>), by name.",
            "items": { "type": "string", "minLength": 1 }
          },
          "runners": {
            "type": "array",
            "description": "The runners this role may run jobs on, by name.",
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": false
      }
    },
    "constants":{
      "type": "object"
    }
  },
  "additionalProperties": false
}
