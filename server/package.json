{
  "name": "ansible-forms",
  "version": "7.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/ansibleforms/ansibleforms.git"
  },
  "description": "The nodejs backend for the ansible forms web applications",
  "scripts": {
    "start": "NODE_ENV=production node ./",
    "dev": "NODE_ENV=development nodemon --watch src --watch schema --watch config ./index.js",
    "dev:rte": "NODE_ENV=development AF_ROLE=rte PORT=${PORT:-8010} HTTPS=0 RTE_TOKEN=dev-rte-token-not-a-secret RTE_URL=http://127.0.0.1:${PORT:-8010} nodemon --watch src --watch config ./index.js",
    "dev:app": "NODE_ENV=development AF_ROLE=app nodemon --watch src --watch schema --watch config ./index.js",
    "dev:app2": "NODE_ENV=development AF_ROLE=app PORT=8001 nodemon --watch src --watch schema --watch config ./index.js",
    "dev:worker": "NODE_ENV=development AF_ROLE=worker PORT=8020 HTTPS=0 nodemon --watch src --watch config ./index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --fix",
    "lint:check": "eslint ."
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "~1.32.1",
    "ajv": "~8.20.0",
    "axios": "~1.20.0",
    "bcrypt": "~6.0.0",
    "cert-info": "~1.5.1",
    "connect-history-api-fallback": "~2.0.0",
    "cookie-session": "~2.1.1",
    "core-js": "~3.50.0",
    "cors": "~2.8.6",
    "croner": "~10.0.1",
    "dayjs": "~1.11.23",
    "dotenv": "~18.0.5",
    "express": "~5.2.1",
    "express-rate-limit": "~8.7.0",
    "fs-extra": "~11.4.1",
    "helmet": "~8.3.0",
    "json-bigint": "~1.0.0",
    "ldap-authentication": "~4.4.1",
    "ldapts": "~9.2.0",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "moment": "~2.31.0",
    "moment-timezone": "0.6.5",
    "mongodb": "~7.7.0",
    "mssql": "~12.7.4",
    "multer": "~2.4.0",
    "mysql2": "~3.24.5",
    "node-cache": "~5.1.2",
    "node-jq": "~6.3.1",
    "nodemailer": "~10.0.15",
    "openid-client": "^6.8.8",
    "oracledb": "~7.0.1",
    "passport": "~0.7.0",
    "passport-http": "~0.3.0",
    "passport-jwt": "~4.0.1",
    "pg": "~8.23.1",
    "prom-client": "~15.1.3",
    "read-last-lines": "~1.10.0",
    "shell-quote": "1.12.0",
    "swagger-ui-express": "~5.0.1",
    "thenby": "~1.4.1",
    "undici": "~7.30.0",
    "winston": "~3.19.0",
    "winston-daily-rotate-file": "~5.0.0",
    "winston-syslog": "~2.7.1",
    "yaml": "~2.9.1",
    "zod": "~4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "~10.12.0",
    "globals": "^17.13.0",
    "nodemon": "~3.1.14",
    "vitest": "^5.0.3"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2022": true
    },
    "extends": [
      "eslint:recommended"
    ],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-unused-vars": "off"
    }
  },
  "author": "ansibleguy",
  "license": "GPL",
  "allowScripts": {
    "bcrypt": true,
    "node-jq": true,
    "oracledb": true,
    "unix-dgram": true,
    "@scarf/scarf": false,
    "core-js": false
  }
}
